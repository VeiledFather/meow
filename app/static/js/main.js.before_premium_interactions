                "deg",

            "--r1":
                (-25 + Math.random() * 50) +
                "deg",

            "--r2":
                (-18 + Math.random() * 36) +
                "deg",

            "--r3":
                (-25 + Math.random() * 50) +
                "deg",

            "--r4":
                (-20 + Math.random() * 40) +
                "deg",

            "--r5":
                (-15 + Math.random() * 30) +
                "deg",

            "--flight":
                (12 + Math.random() * 5) +
                "s"

        };


        Object.entries(
            values
        ).forEach(function (
            entry
        ) {

            butterfly.style.setProperty(
                entry[0],
                entry[1]
            );

        });


        document.body.appendChild(
            butterfly
        );


        butterfly.addEventListener(
            "animationend",
            function () {

                butterfly.remove();

            },
            {
                once: true
            }
        );

    }


    function initNaturalGarden() {

        createGarden();


        /*
         * First butterfly after page load.
         */

        setTimeout(
            spawnButterfly,
            2500
        );


        /*
         * Then approximately every 6 seconds.
         */

        setInterval(
            spawnButterfly,
            6500
        );

    }


    if (
        document.readyState ===
        "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initNaturalGarden,
            {
                once: true
            }
        );

    }

    else {

        initNaturalGarden();

    }

})();



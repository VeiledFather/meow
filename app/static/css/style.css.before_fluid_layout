/* =========================================================
   CINEMATIC AMBIENT FIELD
========================================================= */

.auth-page::before {
    content: "";

    position: absolute;

    width: 720px;
    height: 720px;

    left: 50%;
    top: 42%;

    transform:
        translate(-50%, -50%)
        scale(0.82);

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(181, 140, 255, 0.115) 0%,
            rgba(181, 140, 255, 0.055) 25%,
            rgba(181, 140, 255, 0.018) 46%,
            transparent 70%
        );

    filter: blur(10px);

    pointer-events: none;

    z-index: -5;

    animation:
        campushub-auth-breathe
        9s
        ease-in-out
        infinite;
}


/* Secondary moving light */

.auth-page::after {
    content: "";

    position: absolute;

    width: 430px;
    height: 430px;

    left: 12%;
    top: 18%;

    border-radius: 50%;

    background:
        radial-gradient(

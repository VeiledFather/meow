/* =========================================================
   CAMPUSHUB RESPONSIVE SYSTEM
   Desktop + Tablet + Mobile
   ========================================================= */


/* ---------------------------------------------------------
   GLOBAL RESPONSIVE SAFETY
   --------------------------------------------------------- */

html {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
}

body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
}

img,
video,
canvas,
svg {
    max-width: 100%;
    height: auto;
}

button,
input,
select,
textarea {
    max-width: 100%;
}

table {
    max-width: 100%;
}


/* ---------------------------------------------------------
   LARGE TABLETS / SMALL LAPTOPS
   --------------------------------------------------------- */

@media (max-width: 1100px) {

    .main-content {
        padding-left: 24px;
        padding-right: 24px;
    }

    .stats-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .dashboard-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .content-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .event-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .certificate-list-card {
        grid-template-columns:
            auto minmax(0, 1fr) auto;
    }

}


/* ---------------------------------------------------------
   TABLET
   --------------------------------------------------------- */

@media (max-width: 850px) {

    /* Main layout */

    .main-content {
        width: 100%;
        padding:
            24px 20px;
        margin-left: 0;
    }


    /* Sidebar */

    .sidebar {
        width: 220px;
    }


    /* Headers */

    .dashboard-header,
    .page-header {
        gap: 20px;
        flex-wrap: wrap;
    }

    .dashboard-header > *,
    .page-header > * {
        min-width: 0;
    }


    /* Header actions */

    .dashboard-header-actions,
    .organizer-header-actions {
        width: 100%;
        flex-wrap: wrap;
    }


    /* Cards */

    .stats-grid,
    .dashboard-grid,
    .content-grid,
    .event-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }


    /* Forms */

    .form-row {
        grid-template-columns: 1fr;
    }


    /* Certificate cards */

    .certificate-list-card {
        grid-template-columns:
            auto minmax(0, 1fr);
    }

    .certificate-list-action {
        grid-column: 1 / -1;
        width: 100%;
    }

    .certificate-list-action .primary-btn {
        width: 100%;
    }


    /* Tables */

    .table-container,
    .table-wrapper,
    .responsive-table {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

}



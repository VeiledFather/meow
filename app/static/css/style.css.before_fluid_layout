    filter: blur(18px);

    opacity: 0;

    pointer-events: none;

    animation:
        campushub-auth-brand-glow
        1.4s
        ease
        0.15s
        both;
}


.auth-brand .brand-mark {
    animation:
        campushub-auth-logo
        1.15s
        cubic-bezier(.16, 1, .3, 1)
        both;
}


/* =========================================================
   CARD MATERIALIZATION
========================================================= */

.auth-card {
    position: relative;
    isolation: isolate;

    opacity: 0;

    transform:
        translateY(26px)
        scale(0.965);

    filter:
        blur(7px);

    animation:
        campushub-auth-card
        1.05s
        cubic-bezier(.16, 1, .3, 1)
        0.18s
        forwards;

    box-shadow:
        0 30px 90px rgba(0, 0, 0, 0.34),
        0 0 55px rgba(181, 140, 255, 0.055);
}


/* Fine illuminated border */

.auth-card::before {
    content: "";

    position: absolute;
    inset: 0;

    border-radius: inherit;

    pointer-events: none;

    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.045),
        inset 0 0 40px rgba(181,140,255,0.015);

    z-index: -1;
}


/* Animated border sweep */

.auth-card::after {
    content: "";

    position: absolute;

    left: -100%;
    top: 0;

    width: 55%;
    height: 1px;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(181,140,255,0.55),
            transparent
        );

    box-shadow:
        0 0 16px rgba(181,140,255,0.28);

    pointer-events: none;

    animation:
        campushub-auth-border
        2.4s
        ease
        0.9s
        both;
}


/* =========================================================
   CONTENT REVEALS
========================================================= */

.auth-heading {
    opacity: 0;

    transform:
        translateY(12px);

    animation:
        campushub-auth-content
        0.75s
        cubic-bezier(.16, 1, .3, 1)
        0.55s
        forwards;
}


.auth-card form {
    animation:
        campushub-auth-form
        0.75s
        cubic-bezier(.16, 1, .3, 1)
        0.65s
        both;
}


.auth-card .form-group {
    opacity: 0;

    transform:
        translateY(9px);

    animation:
        campushub-auth-field
        0.55s
        cubic-bezier(.16, 1, .3, 1)
        both;
}


.auth-card .form-group:nth-child(1) {
    animation-delay: 0.72s;
}

.auth-card .form-group:nth-child(2) {
    animation-delay: 0.80s;
}

.auth-card .form-group:nth-child(3) {
    animation-delay: 0.88s;
}

.auth-card .form-group:nth-child(4) {
    animation-delay: 0.96s;
}

.auth-card .form-group:nth-child(5) {
    animation-delay: 1.04s;
}


/* =========================================================
   CTA LIGHT SWEEP
========================================================= */

.auth-card .primary-button {
    position: relative;
    overflow: hidden;

    animation:
        campushub-auth-cta
        0.7s
        cubic-bezier(.16, 1, .3, 1)
        1.12s
        both;
}


.auth-card .primary-button::before {
    content: "";

    position: absolute;

    top: 0;
    left: -130%;

    width: 70%;
    height: 100%;

    background:
        linear-gradient(
            105deg,
            transparent,
            rgba(255,255,255,0.10),
            transparent
        );

    transform:
        skewX(-20deg);

    pointer-events: none;

    animation:
        campushub-auth-button-sweep
        1.25s
        ease
        1.55s
        both;
}


.auth-card .primary-button:hover {
    box-shadow:
        0 0 0 1px rgba(181,140,255,0.15),
        0 0 32px rgba(181,140,255,0.18),
        0 12px 32px rgba(0,0,0,0.24);
}


/* =========================================================
   FOOTER
========================================================= */

.auth-divider,
.auth-footer {
    opacity: 0;

    animation:
        campushub-auth-footer
        0.65s
        cubic-bezier(.16,1,.3,1)
        1.15s
        both;
}


/* =========================================================
   KEYFRAMES
========================================================= */

@keyframes campushub-auth-breathe {

    0%, 100% {
        transform:
            translate(-50%, -50%)
            scale(0.82);
        opacity: 0.65;
    }


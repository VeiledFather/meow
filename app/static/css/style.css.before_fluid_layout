/* =========================================================
   CAMPUSHUB — SIGNATURE SYMMETRIC NEON EXPERIENCE
========================================================= */


/* =========================================================
   AUTH — SYMMETRIC NEON FIELD
========================================================= */

.auth-page {
    position: relative;
    isolation: isolate;
}


/* Central symmetrical light architecture */

.auth-page::before {
    content: "";

    position: absolute;

    left: 50%;
    top: 50%;

    width: min(900px, 92vw);
    height: min(900px, 92vw);

    transform: translate(-50%, -50%);

    border-radius: 50%;

    background:
        radial-gradient(
            ellipse at center,
            rgba(181, 140, 255, 0.105) 0%,
            rgba(181, 140, 255, 0.055) 24%,
            rgba(181, 140, 255, 0.018) 44%,
            transparent 68%
        );

    filter: blur(8px);

    pointer-events: none;

    z-index: -5;

    animation:
        campus-neon-breathe
        7s
        ease-in-out
        infinite;
}


/* Symmetrical horizontal neon architecture */

.auth-page::after {
    content: "";

    position: absolute;

    left: 50%;
    top: 50%;

    width: min(1100px, 110vw);
    height: 2px;

    transform:
        translate(-50%, -50%);

    background:
        linear-gradient(
            90deg,
            transparent 0%,
            rgba(181,140,255,0.02) 20%,
            rgba(181,140,255,0.24) 42%,
            rgba(221,207,255,0.52) 50%,
            rgba(181,140,255,0.24) 58%,
            rgba(181,140,255,0.02) 80%,
            transparent 100%
        );

    filter: blur(2px);

    opacity: .55;

    pointer-events: none;

    z-index: -4;

    animation:
        campus-neon-line
        5s
        ease-in-out
        infinite;
}


/* =========================================================
   AUTH CARD — SYMMETRIC HALO
========================================================= */

.auth-card {
    position: relative;
    isolation: isolate;
}


.auth-card::before {
    content: "";

    position: absolute;

    left: 50%;
    top: 50%;

    width: 125%;
    height: 125%;

    transform:
        translate(-50%, -50%);

    border-radius: inherit;

    background:
        radial-gradient(
            ellipse,
            rgba(181,140,255,0.065),
            transparent 65%
        );

    filter: blur(25px);

    opacity: 0;

    pointer-events: none;

    z-index: -2;

    animation:
        campus-card-halo
        1.8s
        cubic-bezier(.16,1,.3,1)
        .25s
        forwards;
}


/* Four subtle neon corner lights */

.auth-card::after {
    content: "";

    position: absolute;

    inset: 0;

    border-radius: inherit;

    pointer-events: none;

    background:
        radial-gradient(
            circle at 0% 0%,
            rgba(181,140,255,.25),
            transparent 14%
        ),
        radial-gradient(
            circle at 100% 0%,
            rgba(181,140,255,.25),
            transparent 14%
        ),
        radial-gradient(
            circle at 0% 100%,
            rgba(181,140,255,.17),
            transparent 14%
        ),
        radial-gradient(
            circle at 100% 100%,
            rgba(181,140,255,.17),
            transparent 14%
        );

    opacity: .45;

    mix-blend-mode: screen;
}


/* =========================================================
   APPLICATION / DASHBOARD
========================================================= */

/*
   This deliberately targets dashboard-page too.
   Therefore it works even when the body doesn't have
   dashboard-body.
*/

body:has(.dashboard-page),
body:has(.dashboard) {
    position: relative;
    isolation: isolate;
}


/* Symmetrical application glow */

body:has(.dashboard-page)::before,
body:has(.dashboard)::before {

========================================================= */

.auth-page {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    --auth-purple:
        rgba(181, 140, 255, 0.42);

    --auth-purple-soft:
        rgba(181, 140, 255, 0.12);


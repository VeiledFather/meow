    .grid-3,
    .grid-4 {
        grid-template-columns: 1fr !important;
        width: 100%;
    }


    /* ---------- Content cards ---------- */

    .content-card,
    .panel,
    .mini-panel,
    .evai-card,
    .approval-card {
        width: 100%;
        min-width: 0;
        padding: 16px;
    }


    /* ---------- Buttons ---------- */

    .primary-btn,
    .primary-button,
    .secondary-btn,
    .danger-btn,
    .dashboard-action,
    .panel-link,
    .event-action {
        min-height: 44px;
        width: 100%;
        justify-content: center;
        text-align: center;
    }


    /* ---------- Forms ---------- */

    .form-row,
    .form-grid,
    .two-column,
    .three-column {
        grid-template-columns: 1fr !important;
    }

    .form-group {
        width: 100%;
    }

    input,
    select,
    textarea {
        width: 100%;
        min-height: 44px;
        font-size: 16px;
    }

    textarea {
        min-height: 120px;
    }


    /* ---------- Authentication ---------- */

    .auth-page {
        min-height: 100dvh;
        padding:
            20px 12px;
    }

    .auth-container {
        width: 100%;
        max-width: 100%;
        padding: 0;
    }

    .auth-card {
        width: 100%;
        max-width: 100%;
        padding: 22px 16px;
        border-radius: 18px;
    }

    .auth-brand {
        justify-content: center;
        margin-bottom: 18px;
    }

    .auth-heading h1 {
        font-size:
            clamp(1.7rem, 8vw, 2.2rem);
    }

    .auth-heading p {
        font-size: .9rem;
    }


    /* ---------- Identity selector ---------- */

    .identity-selector-card {
        max-width: 100%;
    }

    .identity-choice {
        min-height: 68px;
        padding: 12px;
    }

    .identity-choice-info {
        min-width: 0;
    }

    .identity-choice-info strong {
        overflow-wrap: anywhere;
    }


    /* ---------- Event cards ---------- */

    .student-event-card,
    .volunteer-event-card,
    .event-card {
        width: 100%;
        min-width: 0;
    }

    .event-card-header,
    .event-card-footer,
    .event-meta-row {
        flex-wrap: wrap;
    }


    /* ---------- Organizer / volunteer cards ---------- */

    .organizer-header-actions,
    .volunteer-header-actions {
        display: grid;
        grid-template-columns: 1fr;
    }

    .approval-card {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .campus-identity-row {
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
    }

    .campus-identity-actions {
        width: 100%;
    }

    .identity-action-btn {
        width: 100%;
    }


    /* ---------- Certificates ---------- */

    .certificate-list {
        width: 100%;
    }

    .certificate-list-card {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 14px;

        padding: 16px;
    }

    .certificate-list-icon {
        align-self: flex-start;
    }

    .certificate-list-content {
        min-width: 0;
    }

    .certificate-list-content h2 {
        font-size: 1.25rem;
        overflow-wrap: anywhere;
    }

    .certificate-list-content small {
        display: block;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .certificate-list-action {
        width: 100%;
    }

    .certificate-list-action a {
        width: 100%;
    }


    /* ---------- Certificate viewer ---------- */

    .certificate-container,
    .certificate-card,
    .certificate-page {
        width: 100%;
        max-width: 100%;
    }

    .certificate-card {
        padding: 20px 14px;
    }


    /* ---------- Tables ---------- */

    table {
        width: 100%;
        min-width: 650px;
    }

    .table-container,
    .table-wrapper,
    .responsive-table {
        width: 100%;
        overflow-x: auto;
        border-radius: 12px;
    }


    /* ---------- Admin ---------- */

    .admin-grid,
    .admin-dashboard-grid {
        grid-template-columns: 1fr !important;
    }


    /* ---------- Alerts ---------- */

    .alert {
        width: 100%;
        overflow-wrap: anywhere;
    }


    /* ---------- Long text ---------- */

    h1,
    h2,
    h3,
    h4,
    p,
    span,
    small {
        overflow-wrap: break-word;
    }


    /* ---------- Hide decorative overflow ---------- */

    .auth-glow {
        max-width: 100vw;
        overflow: hidden;
    }

}


/* ---------------------------------------------------------
   SMALL PHONES
   --------------------------------------------------------- */

@media (max-width: 430px) {

    .main-content {
        padding-left: 10px;
        padding-right: 10px;
    }

    .sidebar {
        padding: 10px;
    }

    .sidebar-nav {
        grid-template-columns: 1fr;
    }

    .content-card,
    .panel,
    .mini-panel,
    .evai-card,
    .approval-card {
        padding: 13px;
        border-radius: 14px;
    }

    .stat-card {
        padding: 13px;
    }

    .dashboard-header h1,
    .page-header h1 {
        font-size: 1.65rem;
    }

    .auth-page {
        padding:
            12px 8px;
    }

    .auth-card {
        padding: 18px 13px;
        border-radius: 15px;
    }

    .identity-choice {
        padding: 10px;
    }

    .identity-choice-icon {
        width: 36px;
        height: 36px;
        font-size: 1rem;
    }

}


/* ---------------------------------------------------------
   TOUCH DEVICES
   --------------------------------------------------------- */

@media (hover: none) and (pointer: coarse) {

    .dashboard-action,
    .primary-btn,
    .primary-button,
    .secondary-btn,
    .danger-btn,
    .nav-item,
    .identity-choice,
    button {
        min-height: 44px;
    }

}


/* ---------------------------------------------------------
   LANDSCAPE PHONES
   --------------------------------------------------------- */

@media (max-width: 850px) and (orientation: landscape) {

    .auth-page {
        padding-top: 15px;
        padding-bottom: 15px;
    }

    .auth-card {
        max-height: none;
    }

}


/* ---------------------------------------------------------
   REDUCED MOTION
   --------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
    }

}



:root {
    --black: #08070b;
    --black-soft: #0d0b11;
    --card: #121016;
    --card-hover: #18141f;

    --white: #f8f7fa;
    --muted: #9d97a8;

    --lavender: #b8a1ff;
    --purple: #8e72e8;

    --border: #27222f;
    --border-light: #3a3247;

    --success: #7de2b2;
    --danger: #ff7f9d;

    --radius: 14px;
}


/* =========================
   RESET
========================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    min-height: 100vh;

    background:
        radial-gradient(
            circle at 80% -10%,
            rgba(184, 161, 255, 0.10),
            transparent 32%
        ),
        radial-gradient(
            circle at 10% 100%,
            rgba(142, 114, 232, 0.06),
            transparent 30%
        ),
        var(--black);

    color: var(--white);

    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
}

a {
    color: inherit;
}

button,
input,
textarea,
select {
    font: inherit;
}


/* =========================
   APP
========================= */

.app-shell {
    min-height: 100vh;
}


/* =========================
   SIDEBAR
========================= */

.sidebar {
    position: fixed;
    inset: 0 auto 0 0;

    width: 245px;

    padding: 24px 15px;

    background: rgba(13, 11, 17, 0.94);

    border-right: 1px solid var(--border);

    backdrop-filter: blur(18px);

    z-index: 100;

    display: flex;
    flex-direction: column;
}

.brand {
    display: flex;
    align-items: center;

    gap: 11px;

    padding: 6px 9px;

    margin-bottom: 38px;

    color: var(--white);

    font-size: 18px;
    font-weight: 800;

    letter-spacing: -0.4px;

    text-decoration: none;
}

.brand > span:last-child span {
    color: var(--lavender);
}

.brand-mark {
    width: 38px;
    height: 38px;

    display: grid;
    place-items: center;

    border-radius: 11px;

    background: var(--lavender);
    color: var(--black);

    font-size: 15px;
    font-weight: 900;

    box-shadow:
        0 0 30px rgba(184, 161, 255, 0.22);
}

.brand-mark.large {
    width: 48px;
    height: 48px;

    border-radius: 14px;

    font-size: 18px;
}


/* =========================
   NAVIGATION
========================= */

.nav-section {
    margin-bottom: 28px;
}

.nav-label {
    margin: 0 10px 9px;

    color: #635c70;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 1.5px;
}

.nav-item {
    display: flex;
    align-items: center;

    gap: 12px;

    padding: 10px 11px;
    margin-bottom: 3px;

    border-radius: 9px;

    color: var(--muted);

    font-size: 13px;

    text-decoration: none;

    transition: 0.18s ease;
}

.nav-item span {
    width: 18px;

    text-align: center;

    color: #746b80;

    font-size: 15px;
}

.nav-item:hover {
    background: rgba(184, 161, 255, 0.08);

    color: var(--white);
}

.nav-item:hover span {
    color: var(--lavender);
}


/* =========================
   USER / SIDEBAR BOTTOM
========================= */

.sidebar-bottom {
    margin-top: auto;

    padding-top: 16px;

    border-top: 1px solid var(--border);
}

.user-mini {
    display: flex;
    align-items: center;

    gap: 10px;

    padding: 8px;
}

.avatar {
    width: 32px;
    height: 32px;

    display: grid;
    place-items: center;

    flex-shrink: 0;

    border-radius: 9px;

    background: rgba(184, 161, 255, 0.13);

    color: var(--lavender);

    font-size: 12px;
    font-weight: 800;
}

.user-mini-info {
    min-width: 0;

    display: flex;
    flex-direction: column;

    gap: 2px;
}

.user-mini-info strong {
    overflow: hidden;

    text-overflow: ellipsis;
    white-space: nowrap;

    font-size: 11px;
}

.user-mini-info small {
    color: var(--muted);

    font-size: 9px;
}

.logout {
    display: block;

    padding: 9px;

    color: #756e7e;

    font-size: 11px;

    text-decoration: none;
}

.logout:hover {
    color: var(--danger);
}


/* =========================
   MAIN CONTENT
========================= */

.main-content {
    margin-left: 245px;

    min-height: 100vh;

    padding: 42px 46px;
}

.full-page {
    margin-left: 0;
    padding: 0;
}


/* =========================
   AUTH PAGE
========================= */

.auth-page {
    position: relative;

    min-height: 100vh;

    display: grid;
    place-items: center;

    padding: 25px;

    overflow: hidden;
}

.auth-glow {
    position: absolute;

    width: 520px;
    height: 520px;

    border-radius: 50%;

    background: rgba(184, 161, 255, 0.10);

    filter: blur(90px);

    pointer-events: none;
}

.auth-container {
    position: relative;

    width: 100%;
    max-width: 420px;
}

.auth-brand {
    display: flex;
    justify-content: center;
    align-items: center;

    gap: 12px;

    margin-bottom: 24px;

    color: var(--white);

    font-size: 21px;
    font-weight: 850;

    letter-spacing: -0.6px;
}

.auth-brand span {
    color: var(--lavender);
}

.auth-card {
    padding: 31px;

    background: rgba(18, 16, 22, 0.86);

    border: 1px solid var(--border);

    border-radius: 20px;

    box-shadow:
        0 25px 80px rgba(0, 0, 0, 0.45);

    backdrop-filter: blur(20px);
}

.auth-heading {
    margin-bottom: 25px;
}

.eyebrow {
    color: var(--lavender);

    font-size: 9px;
    font-weight: 850;

    letter-spacing: 1.5px;
}

.auth-heading h1 {
    margin: 8px 0 6px;

    color: var(--white);

    font-size: 31px;

    letter-spacing: -1px;
}

.auth-heading p {
    margin: 0;

    color: var(--muted);

    font-size: 13px;
}

.form-group {
    margin-bottom: 17px;
}

.form-group label {
    display: block;

    margin-bottom: 7px;

    color: #d7d2df;

    font-size: 11px;
    font-weight: 700;
}

.label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.label-row span {
    color: #5f5968;

    font-size: 9px;
}

input,
textarea,
select {
    width: 100%;

    padding: 12px 13px;

    color: var(--white);

    background: #0b090e;

    border: 1px solid var(--border);

    border-radius: 9px;

    outline: none;

    transition: 0.18s ease;
}

input::placeholder,
textarea::placeholder {
    color: #514b59;
}

input:focus,
textarea:focus,
select:focus {
    border-color: var(--lavender);

    box-shadow:
        0 0 0 3px rgba(184, 161, 255, 0.08);
}

select option {
    background: var(--card);
    color: var(--white);
}

.primary-button {
    width: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 10px;

    margin-top: 5px;

    padding: 12px 16px;

    border: 0;
    border-radius: 10px;

    background: var(--lavender);

    color: var(--black);

    font-size: 13px;
    font-weight: 850;

    cursor: pointer;

    transition: 0.18s ease;
}

.primary-button:hover {
    transform: translateY(-1px);

    background: #c6b3ff;

    box-shadow:
        0 10px 30px rgba(184, 161, 255, 0.18);
}

.auth-divider {
    display: flex;
    align-items: center;

    gap: 10px;

    margin: 25px 0 15px;

    color: #4d4754;

    font-size: 8px;

    letter-spacing: 1.5px;
    font-weight: 800;
}

.auth-divider::before,
.auth-divider::after {
    content: "";

    height: 1px;

    flex: 1;

    background: var(--border);
}

.auth-footer {
    margin: 0;

    color: #625c69;

    text-align: center;

    font-size: 10px;
}

.alert {
    padding: 11px 12px;

    margin-bottom: 17px;

    border-radius: 9px;

    font-size: 11px;
}

.alert.error {
    color: #ff9bb0;

    background: rgba(255, 127, 157, 0.08);

    border: 1px solid rgba(255, 127, 157, 0.15);
}


/* =========================
   STUDENT DASHBOARD
========================= */

.dashboard-header {
    display: flex;

    align-items: flex-end;
    justify-content: space-between;

    gap: 25px;

    margin-bottom: 30px;
}

.dashboard-header h1 {
    margin: 8px 0 5px;

    font-size: 34px;

    letter-spacing: -1.2px;
}

.dashboard-header h1 .wave {
    color: var(--lavender);

    font-size: 27px;
}

.dashboard-header p {
    margin: 0;

    color: var(--muted);

    font-size: 13px;
}

.dashboard-action {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 10px;

    padding: 11px 15px;

    border: 1px solid var(--border-light);

    border-radius: 10px;

    background: rgba(184, 161, 255, 0.08);

    color: var(--white);

    text-decoration: none;

    font-size: 12px;
    font-weight: 750;

    transition: 0.18s ease;
}

.dashboard-action:hover {
    border-color: var(--lavender);

    background: rgba(184, 161, 255, 0.13);

    transform: translateY(-1px);
}


/* STATS */

.student-stats {
    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 13px;

    margin-bottom: 18px;
}

.student-stat {
    display: flex;
    align-items: center;

    gap: 13px;

    padding: 17px;

    border: 1px solid var(--border);

    border-radius: 13px;

    background: rgba(18, 16, 22, 0.72);

    transition: 0.18s ease;
}

.student-stat:hover {
    border-color: var(--border-light);

    background: var(--card-hover);
}

.stat-icon {
    width: 36px;
    height: 36px;

    display: grid;
    place-items: center;

    flex-shrink: 0;

    border-radius: 10px;

    color: var(--lavender);

    background: rgba(184, 161, 255, 0.09);

    font-size: 14px;
}

.student-stat span {
    display: block;

    color: #777080;

    font-size: 8px;
    font-weight: 850;

    letter-spacing: 1px;
}

.student-stat strong {
    display: block;

    margin-top: 4px;

    font-size: 23px;

    letter-spacing: -0.5px;
}


/* EVAi */

.evai-card {
    position: relative;

    display: flex;
    align-items: center;

    gap: 20px;

    padding: 23px;

    margin-bottom: 34px;

    overflow: hidden;

    border: 1px solid rgba(184, 161, 255, 0.20);

    border-radius: 16px;

    background:
        radial-gradient(
            circle at 8% 50%,
            rgba(184, 161, 255, 0.14),
            transparent 30%
        ),
        #110e16;
}

.evai-orb {
    width: 54px;
    height: 54px;

    display: grid;
    place-items: center;

    flex-shrink: 0;

    border-radius: 16px;

    color: var(--black);

    background: var(--lavender);

    box-shadow:
        0 0 35px rgba(184, 161, 255, 0.22);

    font-size: 22px;
    font-weight: 900;
}

.evai-content {
    min-width: 0;

    flex: 1;
}

.evai-label {
    color: var(--lavender);

    font-size: 8px;
    font-weight: 850;

    letter-spacing: 1.4px;
}

.evai-content h2 {
    margin: 6px 0;

    color: var(--white);

    font-size: 18px;

    letter-spacing: -0.4px;
}

.evai-content p {
    max-width: 680px;

    margin: 0;

    color: var(--muted);

    font-size: 11px;

    line-height: 1.6;
}

.evai-prompts {
    display: flex;
    flex-wrap: wrap;

    gap: 6px;

    margin-top: 13px;
}

.evai-prompts button {
    padding: 7px 10px;

    border: 1px solid var(--border);

    border-radius: 7px;

    background: rgba(255, 255, 255, 0.025);

    color: #a9a3b3;

    font-size: 9px;

    cursor: pointer;
}

.evai-prompts button:hover {
    border-color: var(--lavender);

    color: var(--white);
}

.evai-open {
    display: inline-flex;

    align-items: center;

    gap: 7px;

    padding: 9px 12px;

    border-radius: 8px;

    background: var(--lavender);

    color: var(--black);

    text-decoration: none;

    font-size: 10px;
    font-weight: 850;

    white-space: nowrap;
}


/* SECTION */

.section-header {
    display: flex;

    align-items: flex-end;
    justify-content: space-between;

    margin-bottom: 15px;
}

.section-header h2 {
    margin: 6px 0 0;

    color: var(--white);

    font-size: 20px;

    letter-spacing: -0.5px;
}

.section-header > a {
    color: var(--lavender);

    font-size: 11px;

    text-decoration: none;
}


/* EVENT CARDS */

.student-event-grid {
    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 13px;

    margin-bottom: 24px;
}

.student-event-card {
    min-height: 230px;

    display: flex;
    flex-direction: column;

    padding: 18px;

    border: 1px solid var(--border);

    border-radius: 14px;

    background: var(--card);

    color: var(--white);

    text-decoration: none;

    transition: 0.2s ease;
}

.student-event-card:hover {
    transform: translateY(-3px);

    border-color: rgba(184, 161, 255, 0.4);

    background: var(--card-hover);

    box-shadow:
        0 15px 40px rgba(0, 0, 0, 0.2);
}

.event-card-top {
    display: flex;

    justify-content: space-between;
    align-items: center;
}

.event-category {
    color: var(--lavender);

    font-size: 8px;
    font-weight: 850;

    letter-spacing: 1px;

    text-transform: uppercase;
}

.event-arrow {
    color: #5d5667;

    font-size: 14px;
}

.student-event-card h3 {
    margin: 18px 0 7px;

    color: var(--white);

    font-size: 16px;

    letter-spacing: -0.3px;
}

.student-event-card > p {
    margin: 0;

    color: var(--muted);

    font-size: 11px;

    line-height: 1.55;

    display: -webkit-box;

    -webkit-line-clamp: 3;

    -webkit-box-orient: vertical;

    overflow: hidden;
}

.event-card-details {
    display: flex;
    flex-direction: column;

    gap: 5px;

    margin-top: auto;

    padding-top: 15px;

    color: #777080;

    font-size: 9px;
}


/* EMPTY */

.dashboard-empty {
    grid-column: 1 / -1;

    padding: 50px 20px;

    text-align: center;

    border: 1px dashed var(--border);

    border-radius: 14px;

    background: rgba(18, 16, 22, 0.5);
}

.empty-symbol {
    margin-bottom: 10px;

    color: var(--lavender);

    font-size: 30px;
}

.dashboard-empty h3 {
    margin: 0 0 5px;

    color: var(--white);

    font-size: 15px;
}

.dashboard-empty p {
    margin: 0 0 17px;

    color: var(--muted);

    font-size: 11px;
}


/* LOWER PANELS */

.dashboard-lower-grid {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 13px;
}

.mini-panel {
    min-height: 190px;

    padding: 20px;

    border: 1px solid var(--border);

    border-radius: 14px;

    background: var(--card);
}

.panel-heading {
    display: flex;

    align-items: flex-start;
    justify-content: space-between;
}

.panel-heading h3 {
    margin: 6px 0 0;

    color: var(--white);

    font-size: 15px;
}

.panel-icon {
    color: var(--lavender);

    font-size: 16px;
}

.empty-mini {
    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    min-height: 95px;

    text-align: center;

    color: var(--muted);
}

.empty-mini > span {
    color: #5d5667;

    font-size: 24px;
}

.empty-mini p {
    margin: 7px 0;

    font-size: 10px;
}

.empty-mini a,
.panel-link {
    color: var(--lavender);

    font-size: 10px;

    text-decoration: none;
}

.hall-preview {
    display: flex;
    align-items: center;

    gap: 12px;

    margin-top: 24px;

    padding: 12px;

    border-radius: 10px;

    background: rgba(255, 255, 255, 0.02);

    border: 1px solid var(--border);
}

.hall-rank {
    color: var(--lavender);

    font-size: 16px;
    font-weight: 850;
}

.hall-preview strong {
    color: var(--white);

    font-size: 11px;
}

.hall-preview p {
    margin: 3px 0 0;

    color: var(--muted);

    font-size: 9px;
}

.hall-preview > span {
    margin-left: auto;

    color: #5d5667;
}

.panel-link {
    display: block;

    margin-top: 12px;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 1100px) {
    .student-stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .student-event-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 800px) {
    .sidebar {
        width: 68px;

        padding: 20px 9px;
    }

    .brand {
        justify-content: center;

        padding: 5px 0;
    }

    .brand > span:last-child {
        display: none;
    }

    .nav-label {
        display: none;
    }

    .nav-item {
        justify-content: center;

        padding: 11px 5px;
    }

    .nav-item span {
        width: auto;
    }

    .user-mini-info,
    .logout {
        display: none;
    }

    .user-mini {
        justify-content: center;

        padding: 5px;
    }

    .main-content {
        margin-left: 68px;

        padding: 28px 20px;
    }
}

@media (max-width: 700px) {
    .dashboard-header {
        align-items: flex-start;

        flex-direction: column;
    }

    .evai-card {
        align-items: flex-start;

        flex-wrap: wrap;
    }

    .evai-open {
        margin-left: 74px;
    }

    .dashboard-lower-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 500px) {
    .auth-page {
        padding: 16px;
    }

    .auth-card {
        padding: 24px 20px;
    }

    .auth-heading h1 {
        font-size: 27px;
    }

    .student-stats {
        grid-template-columns: 1fr;
    }

    .student-event-grid {
        grid-template-columns: 1fr;
    }

    .dashboard-header h1 {
        font-size: 28px;
    }
}
/* =========================================
   VOLUNTEER DASHBOARD
========================================= */

.volunteer-page {
    max-width: 1400px;
    margin: 0 auto;
}


.event-count {
    color: var(--muted);
    font-size: 10px;
}


.security-panel {

    display: flex;
    align-items: center;

    gap: 17px;

    padding: 20px 22px;

    margin-bottom: 34px;

    border: 1px solid rgba(255, 127, 157, .18);

    border-radius: 15px;

    background:
        radial-gradient(
            circle at 5% 50%,
            rgba(255, 127, 157, .08),
            transparent 30%
        ),
        #110e14;
}


.security-icon {

    width: 46px;
    height: 46px;

    display: grid;
    place-items: center;

    flex-shrink: 0;

    border-radius: 13px;

    background: rgba(255, 127, 157, .10);

    color: var(--danger);

    font-size: 20px;

    font-weight: 900;
}


.security-content {
    flex: 1;
}


.security-content h2 {

    margin: 5px 0;

    font-size: 16px;

    letter-spacing: -.3px;
}


.security-content p {

    margin: 0;

    color: var(--muted);

    font-size: 10px;

    line-height: 1.5;
}


.security-button {

    padding: 11px 15px;

    border: 1px solid rgba(255, 127, 157, .25);

    border-radius: 9px;

    background: rgba(255, 127, 157, .08);

    color: #ff9bb0;

    font-size: 10px;

    font-weight: 850;

    cursor: pointer;

    transition: .18s ease;
}


.security-button:hover {

    background: rgba(255, 127, 157, .15);

    border-color: var(--danger);

    transform: translateY(-1px);
}


.volunteer-section-title {
    margin-bottom: 14px;
}


.volunteer-event-list {

    display: flex;

    flex-direction: column;

    gap: 13px;

    margin-bottom: 25px;
}


.volunteer-event-card {

    display: grid;

    grid-template-columns:
        minmax(0, 1.6fr)
        minmax(280px, .8fr);

    gap: 25px;

    padding: 21px;

    border: 1px solid var(--border);

    border-radius: 15px;

    background: var(--card);

    transition: .2s ease;
}


.volunteer-event-card:hover {

    border-color:
        rgba(184, 161, 255, .32);

    background: var(--card-hover);

    transform: translateY(-2px);
}


.volunteer-event-main h3 {

    margin: 14px 0 7px;

    font-size: 19px;

    letter-spacing: -.5px;
}


.volunteer-description {

    max-width: 720px;

    margin: 0;

    color: var(--muted);

    font-size: 11px;

    line-height: 1.6;
}


.approved-badge {

    padding: 5px 8px;

    border-radius: 6px;

    background: rgba(125, 226, 178, .07);

    border: 1px solid rgba(125, 226, 178, .14);

    color: var(--success);

    font-size: 7px;

    font-weight: 850;

    letter-spacing: 1px;
}


.volunteer-details {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 10px;

    margin-top: 22px;

    padding-top: 17px;

    border-top: 1px solid var(--border);
}



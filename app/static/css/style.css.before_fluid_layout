/* =========================================================
   VOLUNTEER QR SCANNER
========================================================= */

.scanner-page {
    max-width: 1200px;
    margin: 0 auto;
}


.scanner-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
    gap: 24px;
    align-items: start;
}


.scanner-card,
.scan-result-card {
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(180, 150, 255, 0.18);
    border-radius: 24px;
    padding: 26px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
}


.scanner-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
}


.scanner-card-header h2 {
    margin: 5px 0 0;
}


.scanner-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    opacity: 0.8;
}


#camera-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #777;
}


#camera-dot.active {
    background: #b99cff;
    box-shadow: 0 0 14px rgba(185, 156, 255, 0.8);
}


.qr-reader {
    width: 100%;
    min-height: 380px;
    border-radius: 20px;
    overflow: hidden;
    background: #08080c;
    border: 1px solid rgba(185, 156, 255, 0.15);
}


.qr-reader video {
    width: 100% !important;
    height: auto !important;
    border-radius: 20px;
}


.scanner-controls {
    display: flex;
    gap: 12px;
    margin-top: 18px;
    flex-wrap: wrap;
}


.scanner-message {
    margin-top: 16px;
    padding: 14px 16px;
    border-radius: 14px;
    background: rgba(185, 156, 255, 0.07);
    border: 1px solid rgba(185, 156, 255, 0.12);
    font-size: 14px;
}


.scanner-message.error {
    border-color: rgba(255, 100, 120, 0.3);
}


.scan-result-card {
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
}


.scan-result-empty,
.scan-success,
.scan-error,
.scan-loading {
    width: 100%;
    text-align: center;
}


.scanner-result-icon,
.result-symbol {
    width: 76px;
    height: 76px;
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 22px;
    font-size: 32px;
    background: rgba(185, 156, 255, 0.1);
    border: 1px solid rgba(185, 156, 255, 0.22);
}


.scan-success .result-symbol {
    color: #cbb5ff;
}


.scan-error .result-symbol {
    color: #ff8e9d;
    background: rgba(255, 100, 120, 0.08);
    border-color: rgba(255, 100, 120, 0.2);
}


.scan-result-card h3 {
    margin: 8px 0;
    font-size: 22px;
}


.scan-result-card p {
    line-height: 1.6;
    opacity: 0.75;
}


.ticket-information {
    margin: 24px 0;
    display: grid;
    gap: 12px;
    text-align: left;
}


.ticket-information > div {
    padding: 13px 15px;
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.06);
}


.ticket-information span {
    display: block;
    font-size: 10px;
    letter-spacing: 1.2px;
    opacity: 0.5;
    margin-bottom: 4px;
}


.ticket-information strong {
    font-size: 14px;
}


.code-value {
    font-family: monospace;
    letter-spacing: 1px;
}


.check-in-btn {
    width: 100%;
    border: none;
    border-radius: 13px;
    padding: 14px 18px;
    cursor: pointer;
    font-weight: 700;
    background: #b99cff;
    color: #100d18;
    transition: transform 0.2s ease, opacity 0.2s ease;
}


.check-in-btn:hover {
    transform: translateY(-2px);
}


.check-in-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
}


.secondary-btn {
    border: 1px solid rgba(185, 156, 255, 0.25);
    background: rgba(185, 156, 255, 0.07);
    color: inherit;
    border-radius: 13px;
    padding: 13px 18px;
    cursor: pointer;
}


.scanner-security {
    margin-top: 24px;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px;
    border-radius: 20px;
    background: rgba(185, 156, 255, 0.055);
    border: 1px solid rgba(185, 156, 255, 0.12);
}


.security-icon {
    font-size: 25px;
}


.scanner-security h3 {
    margin: 5px 0;
}


.scanner-security p {
    margin: 5px 0 0;
    opacity: 0.7;
    line-height: 1.5;
}


.loading-spinner {
    font-size: 38px;
    margin-bottom: 15px;
    animation: scanner-pulse 1s infinite ease-in-out;
}


@keyframes scanner-pulse {

    0% {
        transform: scale(0.9);
        opacity: 0.5;
    }

    50% {
        transform: scale(1.1);
        opacity: 1;
    }

    100% {
        transform: scale(0.9);
        opacity: 0.5;
    }

}


/* =========================================================

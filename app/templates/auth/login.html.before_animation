{% extends "base.html" %}

{% block title %}
Login — CampusHub
{% endblock %}


{% block content %}

<div class="auth-page">

    <div class="auth-glow"></div>

    <div class="auth-container">

        <div class="auth-brand">

            <div class="brand-mark large">
                C
            </div>

            <div>
                Campus<span>Hub</span>
            </div>

        </div>


        <div class="auth-card">

            <div class="auth-heading">

                <span class="eyebrow">
                    UNIVERSITY EVENT NETWORK
                </span>

                <h1>
                    Welcome back.
                </h1>

                <p>
                    Sign in to your CampusHub account.
                </p>

            </div>


            {% with messages =
                get_flashed_messages(
                    with_categories=true
                )
            %}

                {% for category, message in messages %}

                    <div class="alert {{ category }}">
                        {{ message }}
                    </div>

                {% endfor %}

            {% endwith %}


            <form method="POST">

                <div class="form-group">

                    <label>
                        Email or CampusHub ID
                    </label>

                    <input
                        type="text"
                        name="email"
                        placeholder="you@university.edu or CH-S-000005"
                        autocomplete="email"
                        required
                    >

                </div>


                <div class="form-group">

                    <div class="label-row">

                        <label>
                            Password
                        </label>

                        <span>
                            CampusHub account
                        </span>

                    </div>

                    <input
                        type="password"
                        name="password"
                        placeholder="Enter your password"
                        autocomplete="current-password"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="primary-button"
                >
                    Sign in
                    <span>→</span>
                </button>

            </form>


            <div class="auth-divider">

                <span>
                    CAMPUSHUB
                </span>

            </div>


            <p class="auth-footer">
                Don't have a CampusHub account?
                <a href="{{ url_for('auth.register') }}">
                    Register here →
                </a>
            </p>

            <p class="auth-footer">
                Your campus. Your events. One hub.
            </p>

        </div>

    </div>

</div>

{% endblock %}

{% extends "base.html" %}

{% block title %}
User Management — CampusHub
{% endblock %}

{% block content %}

<div class="page-header">

    <div>

        <div class="eyebrow">
            COLLEGE MANAGEMENT
        </div>

        <h1>
            User Management
        </h1>

        <p>
            View students, organizers, volunteers and administrators.
        </p>

    </div>


    <a
        href="{{ url_for('admin.dashboard') }}"
        class="secondary-btn"
    >
        ← Dashboard
    </a>

</div>


<!-- =====================================================
     USER COUNTS
====================================================== -->

<div class="stats-grid">

    <div class="stat-card">

        <span>
            TOTAL USERS
        </span>

        <strong>
            {{ all_users|length }}
        </strong>

    </div>


    <div class="stat-card">

        <span>
            STUDENTS
        </span>

        <strong>
            {{ students|length }}
        </strong>

    </div>


    <div class="stat-card">

        <span>
            ORGANIZERS
        </span>

        <strong>
            {{ organizers|length }}
        </strong>

    </div>


    <div class="stat-card">

        <span>
            VOLUNTEERS
        </span>

        <strong>
            {{ volunteers|length }}
        </strong>

    </div>

</div>


<!-- =====================================================
     USERS
====================================================== -->

<div class="content-card">

    <div class="section-heading">

        <div>

            <h2>
                👥 Campus Users
            </h2>

            <p>
                Registered CampusHub accounts.
            </p>

        </div>

    </div>


    {% if all_users %}

        {% for user in all_users %}

        <div class="approval-card">

            <div class="approval-info">

                <div class="event-type">
                    USER #{{ user.id }}
                </div>


                <h3>
                    {{ user.name }}
                </h3>


                <p>
                    {{ user.email }}
                </p>

            </div>


            <div class="approval-actions">

                {% if user.role == "student" %}

                    <span class="approved-badge">
                        STUDENT
                    </span>

                {% elif user.role == "organizer" %}

                    <span class="approved-badge">
                        ORGANIZER
                    </span>

                {% elif user.role == "volunteer" %}

                    <span class="pending-badge">
                        VOLUNTEER
                    </span>

                {% elif user.role == "admin" %}

                    <span class="event-category">
                        ADMIN
                    </span>

                {% else %}

                    <span class="event-type">
                        {{ user.role|upper }}
                    </span>

                {% endif %}

            </div>

        </div>

        {% endfor %}

    {% else %}

        <div class="empty-state">

            <div>
                👥
            </div>

            <h3>
                No users found
            </h3>

            <p>
                There are currently no registered users.
            </p>

        </div>

    {% endif %}

</div>

{% endblock %}

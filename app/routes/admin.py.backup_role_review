        event_id=event.id
    ).count()


    volunteer_count = VolunteerApplication.query.filter_by(
        event_id=event.id
    ).count()


    return render_template(
        "admin/event_details.html",

        event=event,

        organizer=organizer,

        registration_count=
            registration_count,

        volunteer_count=
            volunteer_count
    )

